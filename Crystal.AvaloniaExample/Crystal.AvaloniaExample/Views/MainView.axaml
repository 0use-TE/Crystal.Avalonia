<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Crystal.AvaloniaExample.ViewModels"
             xmlns:views="using:Crystal.AvaloniaExample.Views"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Crystal.AvaloniaExample.Views.MainView"
             x:DataType="vm:MainViewModel"
             ViewModelLocator.AutoWireViewModel="True">
    <StackPanel Spacing="16" Margin="24" VerticalAlignment="Center">
        <TextBlock Text="{Binding Greeting}" FontSize="22" HorizontalAlignment="Center"/>

        <ContentControl Content="{Binding OuseViewModel}"/>

        <views:ModuleAView HorizontalAlignment="Stretch"/>

        <ContentControl Content="{Binding ModuleBViewModel}"/>
    </StackPanel>
</UserControl>
